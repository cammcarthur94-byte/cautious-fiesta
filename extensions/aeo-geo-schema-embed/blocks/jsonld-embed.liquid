{% comment %}
  AI GEO/AEO/AIO JSON-LD Structured Data App Embed
  Automatically outputs validated JSON-LD schema generated by the AI Optimizer.
{% endcomment %}

{% if product.metafields.geo_aeo.jsonld_schema.value != blank %}
  <!-- AI Search & Answer Engine Optimization (GEO/AEO/AIO) Schema -->
  <script type="application/ld+json" id="geo-aeo-jsonld-{{ product.id }}">
    {{ product.metafields.geo_aeo.jsonld_schema.value | json }}
  </script>
{% elsif product.metafields.geo_aeo.jsonld_schema != blank %}
  <!-- AI Search & Answer Engine Optimization (GEO/AEO/AIO) Schema (Raw Text) -->
  <script type="application/ld+json" id="geo-aeo-jsonld-{{ product.id }}">
    {{ product.metafields.geo_aeo.jsonld_schema }}
  </script>
{% endif %}

{% schema %}
{
  "name": "AI JSON-LD Schema",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "This block automatically injects structured JSON-LD data (Product, Organization, FAQs, AggregateRating) generated by the AI GEO/AEO Optimizer app."
    }
  ]
}
{% endschema %}
